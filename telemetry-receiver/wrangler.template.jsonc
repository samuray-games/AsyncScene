{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asynchronia-telemetry-private-alpha",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://samuray-games.github.io",
    "COHORT_ID": "private_friends_alpha_2026_08",
    "RETENTION_DAYS": "30"
  },
  "secrets": {
    "required": ["OWNER_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asynchronia-telemetry-private-alpha",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "61001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] }
}
